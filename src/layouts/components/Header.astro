---
import HeaderLink from './HeaderLink.astro';
import { useTranslations, type Lang } from '@src/i18n/ui';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);

const menu = [
	{ link: `/posts/`, label: t('nav.posts'), class: 'hidden sm:inline' },
	{ link: `/projects/`, label: t('nav.projects'), class: '' },
	{ link: '/poems/', label: t('nav.poems'), class: '' },
	{ link: `/#contact`, label: t('nav.contact'), class: 'hidden md:inline' }
];
---

<header class='sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-md'>
	<!-- Same outer padding + frame width + inner padding as the page body,
	     so the wordmark sits on the exact column the content starts on
	     instead of hugging the viewport edge. -->
	<div class='px-5 md:px-10'>
		<div class='relative mx-auto flex h-[var(--nav-h)] max-w-[var(--frame)] items-center justify-between gap-4 px-6 md:px-10'>
			<a href='/' class='flex shrink-0 items-center gap-2.5 text-[0.875rem] font-medium leading-5 text-[var(--text)]'>
				<svg width='20' height='20' viewBox='0 0 20 20' aria-hidden='true'>
					<defs>
						<linearGradient id='navMark' x1='0' y1='1' x2='1' y2='0'>
							<stop offset='0' stop-color='#5ac8f5'></stop>
							<stop offset='0.45' stop-color='#2845d6'></stop>
							<stop offset='1' stop-color='#2a2350'></stop>
						</linearGradient>
					</defs>
					<rect width='20' height='20' rx='5' fill='url(#navMark)'></rect>
					<path d='M-2 14 L14 -2 M0 20 L20 0 M6 22 L22 6' stroke='#fff' stroke-opacity='0.26' stroke-width='1'></path>
				</svg>
				mertcantas
			</a>
			<nav
				aria-label='Primary'
				class='flex items-center gap-4 text-[0.8125rem] leading-5 sm:gap-7 sm:text-[0.875rem] md:absolute md:left-1/2 md:-translate-x-1/2 md:gap-10'
			>
				{menu.map((item) => <HeaderLink href={item.link} class={item.class}>{item.label}</HeaderLink>)}
			</nav>
			<div class='flex shrink-0 items-center gap-2.5'>
				<a href='https://github.com/mertcan-tas' target='_blank' rel='noopener noreferrer' class='btn-ghost hidden lg:inline-flex'>
					<svg width='15' height='15' viewBox='0 0 16 16' aria-hidden='true'>
						<path
							fill='currentColor'
							d='M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z'
						></path>
					</svg>
					GitHub
				</a>
				<a href='/#contact' class='btn-primary hidden sm:inline-flex'>{t('nav.getInTouch')}</a>
			</div>
		</div>
	</div>
</header>
