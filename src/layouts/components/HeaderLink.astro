---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = typeof href === 'string' && !href.includes('#') && href !== '/' && pathname.startsWith(href);
---

<a
	href={href}
	class:list={['transition-colors duration-150 hover:text-[var(--text)]', className, isActive ? 'text-[var(--text)]' : 'text-[var(--text-nav)]']}
	{...props}
>
	<slot />
</a>
