---
import Prose from './Prose.astro';
import PageHero from './PageHero.astro';
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '@src/i18n/ui';

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { name, description, tags, demoLink, demoLinkRel, repoLink, coverImage } = project.data;
const { Content } = await render(project);
const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
---

<article>
	<PageHero title={name} lead={description} back={{ href: `/projects/`, label: t('nav.projects') }}>
		<div class='mt-6 flex flex-wrap gap-2 rise' style='animation-delay: 130ms'>
			{(tags || []).map((tag: string) => <span class='chip'>{tag}</span>)}
		</div>
		<div class='mt-8 flex flex-wrap gap-3 rise' style='animation-delay: 160ms'>
			{demoLink && <a href={demoLink} target='_blank' rel={demoLinkRel} class='btn-solid'>{t('card.demo')} <span aria-hidden='true'>↗</span></a>}
			{
				repoLink && (
					<a href={repoLink} target='_blank' rel='noopener noreferrer' class:list={[demoLink ? 'btn-outline' : 'btn-solid']}>
						{t('card.github')} <span aria-hidden='true'>↗</span>
					</a>
				)
			}
		</div>
	</PageHero>
	<div class='border-t border-[var(--border)] px-6 py-10 md:px-10 md:py-14'>
		{
			coverImage && (
				<div class='mb-10 max-w-[var(--col)] overflow-hidden rounded-[10px] border border-[var(--border)] bg-[var(--bg-card)]'>
					<Image class='w-full' src={coverImage} alt={name} loading='eager' />
				</div>
			)
		}
		<Prose>
			<Content />
		</Prose>
	</div>
</article>
