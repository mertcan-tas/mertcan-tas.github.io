---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectCover from './ProjectCover.astro';

interface ProjectCard {
  key: string;
  name: string;
  description?: string;
  demoLink?: string;
  demoLinkRel?: string;
  repoLink?: string;
  detailLink?: string;
  coverImage?: ImageMetadata;
}

const { projects } = Astro.props as { projects: ProjectCard[] };

const short = (url?: string) => url?.replace(/^https?:\/\/(www\.)?/, '').replace(/^github\.com\//, '').replace(/\/$/, '');
---

<ul class="grid grid-cols-1 gap-x-6 gap-y-9 sm:grid-cols-2">
  {
    projects.map((project, i) => {
      const href = project.detailLink ?? project.demoLink ?? project.repoLink;
      const external = !project.detailLink;
      return (
        <li class="group min-w-0">
          <a
            href={href}
            class="block"
            target={external ? '_blank' : undefined}
            rel={external ? (project.demoLink ? project.demoLinkRel : undefined) ?? 'noopener noreferrer' : undefined}
          >
            <div class="relative aspect-[16/9] overflow-hidden rounded-[10px] border border-[var(--border)] bg-[var(--bg-card)] transition-colors duration-200 group-hover:border-[var(--accent)]">
              {project.coverImage ? (
                <Image
                  src={project.coverImage}
                  alt={`${project.name} preview`}
                  width={1200}
                  height={675}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025]"
                />
              ) : (
                <ProjectCover name={project.name} id={project.key} />
              )}
            </div>
            <div class="mt-3 flex items-baseline gap-x-3">
              <h3 class="t-item min-w-0 truncate transition-colors duration-150 group-hover:text-[var(--accent)]">{project.name}</h3>
            </div>
            <p class="t-sm mt-1 line-clamp-2 min-h-10 text-[var(--text-muted)]">{project.description}</p>
            <p class="mt-1.5 flex min-w-0 gap-3 font-mono text-[0.75rem] leading-4 text-[var(--text-faint)]">
              <span class="truncate">{short(project.demoLink ?? project.repoLink)}</span>
            </p>
          </a>
        </li>
      );
    })
  }
</ul>
