---
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type BlogPost = CollectionEntry<'blog'>;
const { post } = Astro.props as { post: BlogPost };
---

<li>
	<a href={`/${post.id}/`} class='group grid gap-1.5 py-4 sm:grid-cols-[1fr_auto] sm:gap-6'>
		<span class='min-w-0'>
			<span class='t-item block transition-colors duration-150 group-hover:text-[var(--accent)]'>{post.data.title}</span>
			<span class='t-sm mt-1 block max-w-[78ch] text-[var(--text-muted)]'>{post.data.description}</span>
		</span>
		<!-- Under the title on phones; right-aligned column on
		     wider screens where it has room of its own. -->
		<span class='flex shrink-0 items-center gap-2 font-mono text-[0.75rem] leading-4 text-[var(--text-faint)] sm:pt-1'>
			<FormattedDate date={post.data.pubDate} />
		</span>
	</a>
</li>
