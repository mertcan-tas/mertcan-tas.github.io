---
import Prose from './Prose.astro';
import PageHero from './PageHero.astro';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { slugify } from '../utils';
import { loadEnv } from 'vite';
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '@src/i18n/ui';

const { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY, GISCUS_CATEGORY_ID } = loadEnv(process.env.NODE_ENV || 'production', process.cwd(), '');

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { title, description, coverImage, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
---

<article>
	<PageHero title={title} lead={description} back={{ href: `/posts/`, label: t('nav.posts') }}>
		<div class='mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 rise' style='animation-delay: 160ms'>
			<span class='font-mono text-[0.75rem] leading-4 text-[var(--text-faint)]'>
				{updatedDate ? t('post.updatedOn') : t('post.publishedOn')}
				<FormattedDate date={updatedDate ?? pubDate} />
			</span>
			<span class='flex flex-wrap gap-2'>
				{(tags || []).map((tag: string) => <a class='chip' href={`/tags/${slugify(tag)}/`}>{tag}</a>)}
			</span>
		</div>
	</PageHero>
	<div class='border-t border-[var(--border)] px-6 py-10 md:px-10 md:py-14'>
		{
			coverImage && (
				<div class='mb-10 max-w-[var(--col)] overflow-hidden rounded-[10px] border border-[var(--border)] bg-[var(--bg-card)]'>
					<Image class='w-full' src={coverImage} alt={title} loading='eager' />
				</div>
			)
		}
		<Prose>
			<Content />
		</Prose>
		{
			GISCUS_REPO && (
				<div class='mt-16 max-w-[var(--col)]'>
					<script
						id='giscus-script'
						is:inline
						src='https://giscus.app/client.js'
						data-repo={GISCUS_REPO}
						data-repo-id={GISCUS_REPO_ID}
						data-category={GISCUS_CATEGORY}
						data-category-id={GISCUS_CATEGORY_ID}
						data-mapping='pathname'
						data-strict='0'
						data-reactions-enabled='1'
						data-emit-metadata='0'
						data-input-position='bottom'
						data-theme='dark'
						data-lang={lang}
						crossorigin='anonymous'
						async></script>
				</div>
			)
		}
	</div>
</article>
