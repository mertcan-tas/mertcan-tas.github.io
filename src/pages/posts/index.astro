---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import PageHero from '@src/components/PageHero.astro';
import PostsByYear from '@src/components/PostsByYear.astro';
import { getPostsByLang } from '@src/i18n/content';
import { useTranslations } from '@src/i18n/ui';

type BlogPost = CollectionEntry<'blog'>;
const t = useTranslations('en');
const title = t('posts.title');
const description = t('posts.description');

const posts = (await getPostsByLang('en')).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={title} description={description}>
	<PageHero title={title} lead={description} />
	<PostsByYear posts={posts} />
</BaseLayout>
