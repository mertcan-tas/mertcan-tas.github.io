---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '@src/i18n/ui';
---

<BaseLayout title={'404 Page Not Found - ' + SITE_TITLE} description={SITE_DESCRIPTION + ' 404 Page Not Found'}>
	<section class='px-6 py-16 md:px-10 md:py-20'>
		<p class='label mb-8'>404</p>
		<h1 class='t-display rise' style='animation-delay: 40ms'>{ui.en['notfound.title']}</h1>
		<p class='t-lead mt-5 max-w-[58ch] text-[var(--text-muted)] rise' style='animation-delay: 100ms'>{ui.en['notfound.body']}</p>
		<div class='mt-8 flex flex-wrap gap-3 rise' style='animation-delay: 160ms'>
			<a href='/' class='btn-solid'>{ui.en['notfound.back']}</a>
		</div>
	</section>
</BaseLayout>
