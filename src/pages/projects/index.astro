---
import BaseLayout from '@src/layouts/BaseLayout.astro';
import PageHero from '@src/components/PageHero.astro';
import ProjectList from '@src/components/ProjectList.astro';
import Section from '@src/components/Section.astro';
import { getProjectsByLang } from '@src/i18n/content';
import { useTranslations } from '@src/i18n/ui';

const t = useTranslations('en');
const projects = (await getProjectsByLang('en')).map((p) => ({
	key: p.data.translationKey,
	name: p.data.name,
	description: p.data.description,
	demoLink: p.data.demoLink,
	demoLinkRel: p.data.demoLinkRel,
	repoLink: p.data.repoLink,
	coverImage: p.data.coverImage,
	detailLink: p.data.hasDetail === false ? undefined : `/projects/${p.data.translationKey}/`
}));
---

<BaseLayout title={t('projects.title')} description={t('projects.description')}>
	<PageHero title={t('projects.title')} lead={t('projects.description')} />
	<Section title={t('nav.projects')} variant='grid'>
		<ProjectList projects={projects} />
	</Section>
</BaseLayout>
