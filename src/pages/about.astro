---
import { Image } from 'astro:assets';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import PageHero from '@src/components/PageHero.astro';
import Section from '@src/components/Section.astro';
import Ava from '@src/assets/img/ava.jpg';
import { useTranslations } from '@src/i18n/ui';

const t = useTranslations('en');
---

<BaseLayout title={t('about.title')} description={t('about.p1')}>
	<PageHero title={t('about.title')} lead={t('about.p1')} />
	<Section title='Mertcan Taş' variant='text'>
		<div class='flex flex-col gap-10 sm:flex-row sm:justify-between'>
			<div class='t-lead max-w-[56ch] text-[var(--text-muted)]'>
				<p>{t('about.p2')}</p>
				<p class='mt-5'>{t('about.p3')}</p>
			</div>
			<Image src={Ava} alt='Mertcan Taş' width={300} class='h-auto w-[18.4rem] max-w-full shrink-0 self-start rounded-[10px] border border-[var(--border)]' />
		</div>
	</Section>
</BaseLayout>
