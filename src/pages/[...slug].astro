---
import { type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Article from '../components/Article.astro';
import { getPostsByLang } from '@src/i18n/content';

export async function getStaticPaths() {
	const posts = await getPostsByLang('en');
	return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}
type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { title, seoTitle, description, coverImage, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout
	title={seoTitle || title}
	description={description}
	image={coverImage}
	imageAlt={title}
	article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags, section: tags?.[0] }}
>
	<Article post={post} />
</BaseLayout>
